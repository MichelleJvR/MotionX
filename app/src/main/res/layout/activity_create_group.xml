<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060715">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="45dp"
            android:paddingEnd="20dp"
            android:paddingBottom="42dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="58dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_leaderboard_back"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CREATE GROUP"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="MotionX Community"
                        android:textColor="#8E87A8"
                        android:textSize="8sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="CANCEL"
                    android:textColor="#B2ABC5"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_create_group_hero"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_group_hero_icon"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="BUILD YOUR CREW."
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create a space where people move together."
                    android:textColor="#B6AEC9"
                    android:textSize="9sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="GROUP DETAILS"
                android:textColor="#DE68FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Group name"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGroupName"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_create_group_input"
                android:hint="e.g. Joburg Morning Runners"
                android:inputType="textCapWords"
                android:maxLength="40"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E6982"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Description"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGroupDescription"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_create_group_input"
                android:gravity="top|start"
                android:hint="Tell athletes what your group is about..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="180"
                android:padding="17dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E6982"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Location"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGroupLocation"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_create_group_input"
                android:hint="e.g. Johannesburg"
                android:inputType="textCapWords"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E6982"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="ACTIVITY TYPE"
                android:textColor="#DE68FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCategoryRunning"
                        android:layout_width="94dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_create_group_option_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🏃  Running"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCategoryWalking"
                        android:layout_width="94dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_create_group_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🚶  Walking"
                        android:textColor="#9A94AC"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCategoryCycling"
                        android:layout_width="94dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_create_group_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🚴  Cycling"
                        android:textColor="#9A94AC"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCategoryGym"
                        android:layout_width="82dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_create_group_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🏋  Gym"
                        android:textColor="#9A94AC"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCategoryHybrid"
                        android:layout_width="90dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_create_group_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="⚡  Hybrid"
                        android:textColor="#9A94AC"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="GROUP ICON"
                android:textColor="#DE68FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iconRun"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_icon_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🏃"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/iconCycle"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🚴"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/iconStrength"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🏋"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/iconFire"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/iconBolt"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="22sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PRIVACY"
                android:textColor="#DE68FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_create_group_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnPublic"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_option_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🌎  PUBLIC"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPrivate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_group_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🔒  PRIVATE"
                    android:textColor="#9A94AC"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_create_group_setting"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="17dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Approve new members"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Review requests before people can join."
                        android:textColor="#817A96"
                        android:textSize="9sp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchApproval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:showText="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_create_group_summary"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY TO MOVE?"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your group can be updated later from Group Settings."
                    android:textColor="#A59EB8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/btnCreateGroup"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/bg_create_group_button"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="CREATE GROUP  →"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.07" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="MOVE. TRACK. ACHIEVE."
                android:textColor="#5E5874"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>