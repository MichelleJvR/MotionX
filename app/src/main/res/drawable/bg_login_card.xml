<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- LIGHTER MOTIONX PURPLE GLASS -->
    <gradient
        android:angle="90"
        android:startColor="#A82D1658"
        android:centerColor="#961C1040"
        android:endColor="#A8100929"
        android:type="linear" />

    <!-- LARGE PREMIUM ROUNDED CORNERS -->
    <corners android:radius="30dp" />

    <!-- PURPLE GLASS BORDER -->
    <stroke
        android:width="1dp"
        android:color="#B58C4CFF" />

    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>